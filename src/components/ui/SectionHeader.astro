---
interface Props {
  title: string;
  titleEn?: string;
  subtitle?: string;
  subtitleEn?: string;
  id?: string;
  align?: 'left' | 'center';
}

const { title, titleEn, subtitle, subtitleEn, id, align = 'center' } = Astro.props;
---

<div class:list={['section-header', `section-header--${align}`]} id={id}>
  <h2 class="section-header__title">
    {titleEn ? (
      <>
        <span class="i18n-zh">{title}</span><span class="i18n-en">{titleEn}</span>
      </>
    ) : title}
  </h2>
  {subtitle && (
    <p class="section-header__subtitle">
      {subtitleEn ? (
        <>
          <span class="i18n-zh">{subtitle}</span><span class="i18n-en">{subtitleEn}</span>
        </>
      ) : subtitle}
    </p>
  )}
</div>

<style>
  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-header--center {
    text-align: center;
  }

  .section-header__title {
    font-size: 1.8rem;
    color: var(--mai-text);
    margin-bottom: 0.75rem;
  }

  .section-header__subtitle {
    font-size: 1.05rem;
    color: var(--mai-text-muted);
    max-width: 640px;
    line-height: 1.7;
  }

  .section-header--center .section-header__subtitle {
    margin: 0 auto;
  }
</style>

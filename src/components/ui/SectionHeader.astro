---
interface Props {
  title: string;
  subtitle?: string;
  id?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, id, align = 'center' } = Astro.props;
---

<div class:list={['section-header', `section-header--${align}`]} id={id}>
  <h2 class="section-header__title">{title}</h2>
  {subtitle && <p class="section-header__subtitle">{subtitle}</p>}
</div>

<style>
  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-header--center {
    text-align: center;
  }

  .section-header__title {
    font-size: 1.8rem;
    color: var(--mai-text);
    margin-bottom: 0.75rem;
  }

  .section-header__subtitle {
    font-size: 1.05rem;
    color: var(--mai-text-muted);
    max-width: 640px;
    line-height: 1.7;
  }

  .section-header--center .section-header__subtitle {
    margin: 0 auto;
  }
</style>

---
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import Lang from '../ui/Lang.astro';
import { GITHUB_URL } from '../../lib/constants';

const points = [
  { zh: '本地运行，无需云端账号', en: 'Runs locally — no cloud account required' },
  { zh: 'SQLite 默认数据存储', en: 'SQLite as the default data store' },
  { zh: '可配置模型 Provider 和 API Key', en: 'Configure your own model providers and API keys' },
  { zh: '支持 OpenAI、Anthropic、Gemini、OpenRouter 等', en: 'Works with OpenAI, Anthropic, Gemini, OpenRouter, and more' },
  { zh: '开源仓库，社区可参与', en: 'Open-source repository, community-friendly' },
  { zh: '适合高阶用户与创作者长期使用', en: 'Built for power users and creators who stick around' },
];
---

<section class="os">
  <div class="os__inner">
    <SectionHeader
      title="本地优先，开源可控"
      titleEn="Local-first, open-source, under your control"
      subtitle="MAI 以本地优先为核心。你可以在自己的环境中运行、配置模型 Provider 和 API Key，并根据需要选择不同模型供应商或兼容 LiteLLM 的自定义模型。"
      subtitleEn="MAI puts local first. Run it in your own environment, plug in your own model providers and API keys, and switch between vendors or any LiteLLM-compatible custom model whenever you need."
    />

    <div class="os__content">
      <div class="os__points">
        {points.map((p) => (
          <div class="os__point">
            <span class="os__check">&#10003;</span>
            <span>
              <Lang zh={p.zh} en={p.en} />
            </span>
          </div>
        ))}
      </div>
      <div class="os__cta">
        <Button href={GITHUB_URL} variant="outline" size="lg" target="_blank" rel="noopener noreferrer">
          <Lang zh="查看 GitHub 仓库" en="Open the GitHub repository" />
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .os {
    padding: 5rem 0;
  }

  .os__inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .os__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .os__points {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.75rem;
    width: 100%;
  }

  .os__point {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--mai-text);
  }

  .os__check {
    color: var(--mai-mint);
    font-weight: 700;
    font-size: 0.85rem;
    width: 22px;
    height: 22px;
    background: var(--mai-mint-soft);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
</style>

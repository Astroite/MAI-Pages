---
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import { GITHUB_URL } from '../../lib/constants';

const points = [
  '本地运行，无需云端账号',
  'SQLite 默认数据存储',
  '可配置模型 Provider 和 API Key',
  '支持 OpenAI、Anthropic、Gemini、OpenRouter 等',
  '开源仓库，社区可参与',
  '适合高阶用户与创作者长期使用',
];
---

<section class="os">
  <div class="os__inner">
    <SectionHeader
      title="本地优先，开源可控"
      subtitle="MAI 以本地优先为核心。你可以在自己的环境中运行、配置模型 Provider 和 API Key，并根据需要选择不同模型供应商或兼容 LiteLLM 的自定义模型。"
    />

    <div class="os__content">
      <div class="os__points">
        {points.map((p) => (
          <div class="os__point">
            <span class="os__check">&#10003;</span>
            <span>{p}</span>
          </div>
        ))}
      </div>
      <div class="os__cta">
        <Button href={GITHUB_URL} variant="outline" size="lg" target="_blank" rel="noopener noreferrer">
          查看 GitHub 仓库
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .os {
    padding: 5rem 0;
  }

  .os__inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .os__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .os__points {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.75rem;
    width: 100%;
  }

  .os__point {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--mai-text);
  }

  .os__check {
    color: var(--mai-mint);
    font-weight: 700;
    font-size: 0.85rem;
    width: 22px;
    height: 22px;
    background: var(--mai-mint-soft);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
</style>
